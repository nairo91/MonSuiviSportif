# --- Base de données (obligatoire pour l'auth et la persistance) ---
# Postgres (Neon, Supabase, local...). Les tables sont créées automatiquement.
DATABASE_URL="postgresql://user:password@host/dbname"

# --- Session (OBLIGATOIRE en production) ---
# Clé de signature HMAC des cookies de session. Générer par ex. :
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacez-par-une-longue-cle-aleatoire"

# --- Coach IA (optionnel) ---
# Clé API Anthropic pour la génération de plans d'entraînement.
ANTHROPIC_API_KEY=""

# Emails autorisés à générer des plans IA (séparés par des virgules).
# Sans cette variable, la génération IA est désactivée pour tout le monde.
ADMIN_EMAILS="vous@exemple.com"
